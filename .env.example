# Configuração opcional da IA local. Não é necessária nenhuma chave API.
# Modelo recomendado para começar em computadores com 32 GB de RAM:
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_BASE_URL=http://127.0.0.1:11434
PORT=8000

# Se a tua placa gráfica tiver VRAM suficiente, podes experimentar:
# OLLAMA_MODEL=qwen3.5:9b
